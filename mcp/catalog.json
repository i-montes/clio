        "sha256": "370601106c1b5619aae5f06f7a3fdc60836486135934779461e2a208d777f596"
      },
      "linux-arm64": {
        "url": "https://cdn.playwright.dev/builds/cft/159.0.8154.6/linux-arm64/chrome-linux-arm64.zip",
